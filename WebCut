/* ---------- Exportar ---------- */
ex=document.createElement('canvas');eg=ex.getContext('2d',{alpha:false});
let dirH=null,xs=null;
const dims=()=>{const q=+$('#xq').value,r=cv.width/cv.height;return r>=1?[Math.round(q*r/2)*2,q]:[q,Math.round(q/r/2)*2]};
const info=()=>{const[W,H]=dims();$('#xi').textContent=W+'×'+H+' · '+$('#xf').value+' fps'+(+$('#xq').value>1440?' · O 4K exige um PC potente; a gravação acontece em tempo real.':'')};
$('#xq').onchange=$('#xf').onchange=info;
$('#bEx').onclick=()=>{if(exporting)return;if(!total()){alert('Adicione clipes à linha do tempo antes de exportar.');return}pause();info();$('#dlg').hidden=false};
$('#xc').onclick=()=>$('#dlg').hidden=true;
$('#xd').onclick=async()=>{try{dirH=await showDirectoryPicker({mode:'readwrite'});$('#xdn').textContent=dirH.name}catch(e){if(e.name!=='AbortError'){dirH=null;$('#xdn').textContent='Sem suporte: usará Downloads'}}};
const prog=()=>{const p=Math.min(100,Math.round(t/total()*100));$('#xb').style.width=p+'%';$('#xp').textContent=p+'%'};
$('#xg').onclick=async()=>{
 $('#dlg').hidden=true;
 const[W,H]=dims(),fps=+$('#xf').value,q=+$('#xq').value;ex.width=W;ex.height=H;
 const mime=['video/mp4;codecs=avc1,mp4a.40.2','video/webm;codecs=vp9,opus','video/webm'].find(m=>MediaRecorder.isTypeSupported(m)),ext=mime.includes('mp4')?'mp4':'webm';
 const name=($('#xn').value.trim()||'video-editado').replace(/[\\/:*?"<>|]/g,'_')+'.'+ext;
 let w=null;
 if(dirH){try{w=await(await dirH.getFileHandle(name,{create:true})).createWritable()}catch(_){w=null}}
 const st=ex.captureStream(fps);dest&&dest.stream.getAudioTracks().forEach(x=>st.addTrack(x));
 const chunks=[],bps=({1080:10e6,1440:20e6,2160:45e6}[q])*(fps>30?1.5:1);
 const r=new MediaRecorder(st,{mimeType:mime,videoBitsPerSecond:bps});wq=Promise.resolve();xs={cancel:false};
 r.ondataavailable=e=>{if(!e.data.size)return;if(w)wq=wq.then(()=>w.write(e.data));else chunks.push(e.data)};
 r.onstop=async()=>{
  await wq;
  if(w){xs.cancel?await w.abort():await w.close()}
  else if(!xs.cancel){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(chunks,{type:mime}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),6e4)}
  exporting=null;$('#ld').hidden=true};
 t=0;exporting=r;prog();$('#ld').hidden=false;ac&&ac.resume();draw(true);r.start(1000);play();
};
$('#xx').onclick=()=>{if(!exporting)return;xs.cancel=true;pause();exporting.state!=='inactive'&&exporting.stop()};
function finishExport(){setTimeout(()=>exporting&&exporting.state!=='inactive'&&exporting.stop(),300)}

/* ---------- Texto e painel de propriedades ---------- */
const TP={t:[96,0,'Seu título'],s:[56,15,'Subtítulo'],l:[40,38,'Legenda aqui']};
document.querySelectorAll('[data-p]').forEach(b=>b.onclick=()=>{
 const [size,y,text]=TP[b.dataset.p];snap();
 const c={id:uid++,mid:0,kind:'text',track:2,start:t,in:0,dur:3,...DP,text,size,y,color:'#ffffff',font:'Arial',stroke:true};
 clips.push(c);sel=c.id;inspTab='Texto';render()});
const TABS={video:['Transformar','Cor','Volume'],image:['Transformar','Cor'],audio:['Volume'],text:['Texto','Transformar']};
const CTRL={
 Transformar:[['Escala','scale',10,400,1,'%'],['Posição X','x',-100,100,1,'%'],['Posição Y','y',-100,100,1,'%'],['Girar','rot',-180,180,1,'°']],
 Cor:[['Saturação','sat',0,300,1,'%'],['Brilho','bri',0,200,1,'%'],['Contraste','con',0,200,1,'%']],
 Volume:[['Volume','vol',0,200,1,'%']]};
function slider(c,lb,key,mn,mx,st,u){
 const d=document.createElement('div');d.className='row';
 d.innerHTML=`<label>${lb}</label><input type="range" min="${mn}" max="${mx}" step="${st}"><input type="number" min="${mn}" max="${mx}" step="${st}"><span>${u}</span>`;
 const r=d.children[1],n=d.children[2];r.value=n.value=c[key];
 const set=v=>{v=Math.min(mx,Math.max(mn,+v||0));c[key]=v;r.value=n.value=v;draw(false)};
 r.onpointerdown=n.onfocus=()=>snap();
 r.oninput=()=>set(r.value);n.onchange=()=>set(n.value);return d}
function inspect(){
 inspSel=sel;const el=$('#insp'),c=clips.find(c=>c.id===sel);
 if(!c){el.innerHTML='<div class="empty">Selecione um clipe na linha do tempo para editar escala, posição, volume, saturação e textos.</div>';return}
 const tabs=TABS[MM(c).type];if(!tabs.includes(inspTab))inspTab=tabs[0];
 el.innerHTML='<div class="tabs"></div><div class="tab on"></div>';
 const tb=el.children[0],bd=el.children[1];
 tabs.forEach(n=>{const b=document.createElement('button');b.textContent=n;if(n===inspTab)b.className='on';b.onclick=()=>{inspTab=n;inspect()};tb.append(b)});
 if(inspTab==='Texto'){
  const ta=document.createElement('textarea');ta.rows=3;ta.value=c.text;ta.style.marginBottom='14px';
  ta.onfocus=()=>snap();ta.oninput=()=>{c.text=ta.value;render();draw(false)};bd.append(ta);
  bd.append(slider(c,'Tamanho','size',10,300,1,'px'));
  const f=document.createElement('div');f.className='f';
  f.innerHTML='<span>Cor</span><input type="color">';f.lastChild.value=c.color;f.lastChild.oninput=e=>{c.color=e.target.value;draw(false)};bd.append(f);
  const f2=document.createElement('div');f2.className='f';
  f2.innerHTML='<span>Fonte</span><select>'+['Arial','Georgia','Impact','Courier New','Comic Sans MS','Verdana'].map(x=>`<option${x===c.font?' selected':''}>${x}</option>`).join('')+'</select>';
  f2.lastChild.onchange=e=>{c.font=e.target.value;draw(false)};bd.append(f2);
  const f3=document.createElement('label');f3.className='f';f3.innerHTML='<span>Contorno preto</span><input type="checkbox">';
  f3.lastChild.checked=c.stroke;f3.lastChild.onchange=e=>{c.stroke=e.target.checked;draw(false)};bd.append(f3);
 }else{
  CTRL[inspTab].forEach(r=>bd.append(slider(c,...r)));
  const b=document.createElement('button');b.textContent='↺ Restaurar padrão';
  b.onclick=()=>{snap();CTRL[inspTab].forEach(r=>c[r[1]]=DP[r[1]]);inspect();draw(false)};bd.append(b);
 }
}
cv.onpointerdown=e=>{
 const c=clips.find(c=>c.id===sel);if(!c||c.track===1)return;snap();
 const r=cv.getBoundingClientRect(),x0=e.clientX,y0=e.clientY,ox=c.x,oy=c.y;
 const mv=ev=>{c.x=Math.round(ox+(ev.clientX-x0)/r.width*100);c.y=Math.round(oy+(ev.clientY-y0)/r.height*100);draw(false);inspect()};
 const up=()=>{removeEventListener('pointermove',mv);removeEventListener('pointerup',up)};
 addEventListener('pointermove',mv);addEventListener('pointerup',up)};
addEventListener('resize',render);
listMedia();ratios();scList();render();requestAnimationFrame(tick);
</script></body></html>
